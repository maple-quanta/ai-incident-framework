<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>AI Incident Report — {{ incident.incident_id }}</title>
<style>
:root{color-scheme:light;--ink:#152229;--muted:#53636b;--line:#ced9dd;--brand:#174f45;--paper:#fff;--wash:#f1f6f4;--warn:#8b2f2f}*{box-sizing:border-box}body{margin:0;background:#e8efec;color:var(--ink);font:15px/1.55 system-ui,sans-serif}.page{max-width:1040px;margin:24px auto;background:var(--paper);padding:44px;box-shadow:0 8px 32px #18332a20}.handling{border:2px solid var(--warn);padding:10px 14px;font-weight:700}.kicker{color:var(--brand);font-weight:700;letter-spacing:.08em;text-transform:uppercase}h1{font-size:2rem}h2{margin-top:2.2rem;border-bottom:2px solid var(--brand);padding-bottom:.25rem}h3{margin-bottom:.3rem}.profile{background:var(--wash);border-left:5px solid var(--brand);padding:14px;font-family:ui-monospace,monospace;overflow-wrap:anywhere}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.card{border:1px solid var(--line);padding:12px}.label{color:var(--muted);font-size:.82rem;text-transform:uppercase}.value{font-weight:700;font-size:1.05rem}table{border-collapse:collapse;width:100%;display:block;overflow-x:auto}th,td{border:1px solid var(--line);padding:8px;text-align:left;vertical-align:top}th{background:var(--wash)}.notice{background:#fff7df;border-left:4px solid #b47a00;padding:12px}.severity{font-size:1.25rem;font-weight:800}.muted{color:var(--muted)}@media print{body{background:#fff}.page{margin:0;box-shadow:none;max-width:none}}
</style></head><body><main class="page">
<div class="handling">HANDLING: {{ incident.handling.classification }} · Distribution: {{ incident.handling.distribution | join(', ') if incident.handling.distribution else 'Not specified' }}</div>
<p class="kicker">MQ-AICIR {{ incident.framework.version }}</p><h1>AI Incident Report</h1><p>{{ incident.incident_id }} · {{ incident.title }}</p>
<h2>Executive Summary</h2><p>{{ incident.executive_summary or incident.description or 'No executive summary recorded.' }}</p><p class="severity">Severity: {{ severity.severity }}</p><ul>{% for item in severity.rationale %}<li>{{ item }}</li>{% endfor %}</ul>
<h2>Incident Classification</h2><p class="profile">Incident Profile: {{ vector }}</p><div class="grid">
<div class="card"><div class="label">Event state</div><div class="value">{{ incident.event_state }} — {{ label(incident.event_state) }}</div></div>
<div class="card"><div class="label">Authority exercised</div><div class="value">{{ incident.authority.actually_exercised | join(', ') or 'None' }}</div></div>
<div class="card"><div class="label">Boundaries</div><div class="value">{{ boundary_labels | join('; ') }}</div></div>
<div class="card"><div class="label">Harm realized / potential</div><div class="value">{{ incident.harm.realized_level }} — {{ label(incident.harm.realized_level) }} / {{ incident.harm.potential_level }} — {{ label(incident.harm.potential_level) }}</div></div>
<div class="card"><div class="label">Reversibility</div><div class="value">{{ incident.reversibility }} — {{ label(incident.reversibility) }}</div></div>
<div class="card"><div class="label">Observability</div><div class="value">{{ incident.observability.level }} — {{ label(incident.observability.level) }}</div></div>
<div class="card"><div class="label">Blast radius</div><div class="value">{{ incident.blast_radius }} — {{ label(incident.blast_radius) }}</div></div>
<div class="card"><div class="label">Lifecycle</div><div class="value">{{ incident.lifecycle_status }}</div></div></div><p>Triggered rules: {{ severity.triggered_rules | join(', ') }}</p>
<h2>AI System Information</h2><dl><dt>System/model</dt><dd>{{ incident.system.name }}{% if incident.system.model %} / {{ incident.system.model }}{% endif %}</dd><dt>Model version</dt><dd>{{ incident.system.model_version or 'Not recorded' }}</dd><dt>Environment</dt><dd>{{ incident.system.deployment_environment or 'Not recorded' }}</dd><dt>Assurance boundary</dt><dd>{{ incident.system.assurance_boundary or 'Not recorded' }}</dd><dt>MCAI before / after</dt><dd>{{ incident.mcai.pre_incident_assessed or 'N/A' }} / {{ incident.mcai.post_incident_reassessed or 'N/A' }}</dd></dl>
<h2>Event Timeline</h2><table><thead><tr><th>Timestamp</th><th>Type</th><th>Actor</th><th>Description</th><th>Evidence</th></tr></thead><tbody>{% for event in incident.timeline %}<tr><td>{{ event.timestamp }}</td><td>{{ event.event_type }}</td><td>{{ event.actor }}</td><td>{{ event.description }}</td><td>{{ event.evidence_refs | join(', ') }}</td></tr>{% else %}<tr><td colspan="5">No timeline events recorded.</td></tr>{% endfor %}</tbody></table>
<h2>Authority Exercised</h2><p><strong>Authorized:</strong> {{ incident.authority.authorized | join(', ') or 'None' }}<br><strong>Actually exercised:</strong> {{ incident.authority.actually_exercised | join(', ') or 'None' }}<br><strong>Unauthorized exercised:</strong> {{ incident.authority.unauthorized_exercised | join(', ') or 'None' }}</p><p>The authorized/actual difference is explicit and independent of harm.</p>
<h2>Boundary Analysis</h2><ul>{% for boundary in boundary_labels %}<li>{{ boundary }}</li>{% endfor %}</ul>
<h2>Assets Affected</h2>{% for asset in incident.assets_affected %}<p><strong>{{ asset.type }} — {{ asset.name }}</strong> ({{ asset.criticality }}) · owner {{ asset.owner or 'not recorded' }}<br>{{ asset.description }}</p>{% else %}<p>No affected assets recorded.</p>{% endfor %}
<h2>Harm Assessment</h2><p><strong>Realized:</strong> {{ incident.harm.realized_level }} — {{ label(incident.harm.realized_level) }}<br><strong>Potential:</strong> {{ incident.harm.potential_level }} — {{ label(incident.harm.potential_level) }}<br><strong>Categories:</strong> {{ incident.harm.categories | join(', ') or 'None' }}<br>{{ incident.harm.description }}</p>
<h2>Reversibility</h2><p>{{ incident.reversibility }} — {{ label(incident.reversibility) }}</p>
<h2>Observability</h2><p>{{ incident.observability.level }} — {{ label(incident.observability.level) }}. A larger O-number means <strong>worse</strong> observability.</p><p>Evidence sources: {{ incident.observability.evidence_sources | join(', ') or 'None' }}<br>Missing: {{ incident.observability.missing_evidence | join(', ') or 'None identified' }}<br>Tamper risk: {{ incident.observability.tamper_risk }}</p>
<h2>Intervention &amp; Containment</h2><div class="grid"><div class="card">Detection<br><strong>{{ incident.containment.detection_time_seconds if incident.containment.detection_time_seconds is not none else 'N/A' }} s</strong></div><div class="card">Decision<br><strong>{{ incident.containment.decision_time_seconds if incident.containment.decision_time_seconds is not none else 'N/A' }} s</strong></div><div class="card">Enforcement<br><strong>{{ incident.containment.enforcement_time_seconds if incident.containment.enforcement_time_seconds is not none else 'N/A' }} s</strong></div><div class="card">Intervention Time<br><strong>{{ incident.containment.intervention_time_seconds if incident.containment.intervention_time_seconds is not none else 'N/A' }} s</strong></div><div class="card">Damage Time<br><strong>{{ incident.containment.damage_time_seconds if incident.containment.damage_time_seconds is not none else 'N/A' }} s</strong></div><div class="card">Containment Margin<br><strong>{{ '%.2f' | format(incident.containment.containment_margin) if incident.containment.containment_margin is not none else 'N/A' }}</strong></div></div><p>{{ containment_interpretation }}</p><p><strong>Documentation:</strong> {{ incident.containment.documentation or 'Not recorded' }}<br><strong>Preventive control:</strong> {{ incident.containment.preventive_control or 'Not recorded' }}</p>
<h2>Root Cause</h2>{% if incident.root_cause %}<p><strong>Primary:</strong> {{ incident.root_cause.primary_root_cause }}<br><strong>Contributing:</strong> {{ incident.root_cause.contributing_factors | join(', ') or 'None' }}<br>{{ incident.root_cause.analysis }}</p>{% else %}<p>Root cause has not yet been recorded.</p>{% endif %}
<h2>Control Performance</h2>{% for control in incident.control_performance %}<h3>{{ control.control_id }} — {{ control.control_name }}</h3><p>Status: <strong>{{ control.status }}</strong><br>Expected: {{ control.expected_behavior }}<br>Observed: {{ control.observed_behavior }}<br>Evidence: {{ control.evidence | join(', ') or 'None' }}</p>{% else %}<p>No control-performance records.</p>{% endfor %}
<h2>Evidence</h2>{% for item in incident.evidence %}<p><strong>{{ item.id }} — {{ item.type }}</strong><br>{{ item.description }}<br>Location: {{ item.location }}{% if item.hash %}; digest: {{ item.hash }}{% endif %}{% if item.redacted %}; redacted reference{% endif %}</p>{% else %}<p>No evidence references recorded. Do not embed secrets in this record.</p>{% endfor %}
<h2>Notifications</h2><p>Internal teams: {{ incident.notifications.affected_internal_teams | join(', ') or 'None recorded' }}<br>Affected third parties: {{ incident.notifications.affected_third_parties | join(', ') or 'None recorded' }}<br>Contractual notification: {{ incident.notifications.contractual_notification_required }}<br>Regulatory notification: {{ incident.notifications.regulatory_notification_required }}<br>Legal review required: {{ incident.notifications.legal_review_required }}</p><p class="notice">{{ legal_notice }}</p>
<h2>Corrective Actions</h2>{% for action in incident.corrective_actions %}<h3>{{ action.action_id }} — {{ action.priority }} / {{ action.status }}</h3><p>{{ action.recommended_action }}<br>Finding: {{ action.finding }}<br>Owner: {{ action.owner or 'Unassigned' }}; due: {{ action.due_date or 'Not set' }}<br>Verification required: {{ action.verification_required }}; evidence: {{ action.verification_evidence | join(', ') or 'None' }}</p>{% else %}<p>No corrective actions recorded.</p>{% endfor %}
<h2>Revalidation</h2><p>{{ incident.revalidation or 'Not yet recorded.' }}</p><h2>Closure</h2><p>{{ incident.closure_rationale or 'Incident is not closed or no closure rationale has been recorded.' }}</p>{% if incident.lifecycle_override %}<p class="notice">Exception override by {{ incident.lifecycle_override.responsible_person }} at {{ incident.lifecycle_override.timestamp }}: {{ incident.lifecycle_override.rationale }}</p>{% endif %}
</main></body></html>
