{
  "$defs": {
    "AISystemInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "deployment_environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployment Environment"
        },
        "assurance_boundary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assurance Boundary"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "AISystemInfo",
      "type": "object"
    },
    "AffectedAsset": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/AssetType"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "criticality": {
          "$ref": "#/$defs/AssetCriticality",
          "default": "medium"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "AffectedAsset",
      "type": "object"
    },
    "AssetCriticality": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "AssetCriticality",
      "type": "string"
    },
    "AssetType": {
      "enum": [
        "DATA",
        "IDENTITY",
        "MODEL",
        "TOOL",
        "CODE",
        "INFRASTRUCTURE",
        "FINANCIAL",
        "OPERATIONS",
        "HUMAN",
        "RIGHTS",
        "PHYSICAL",
        "CRITICAL_INFRASTRUCTURE",
        "THIRD_PARTY"
      ],
      "title": "AssetType",
      "type": "string",
      "description": "Category of asset affected by the AI event."
    },
    "AuthorityAssessment": {
      "additionalProperties": false,
      "properties": {
        "authorized": {
          "items": {
            "$ref": "#/$defs/AuthorityClass"
          },
          "title": "Authorized",
          "type": "array"
        },
        "actually_exercised": {
          "items": {
            "$ref": "#/$defs/AuthorityClass"
          },
          "title": "Actually Exercised",
          "type": "array"
        },
        "unauthorized_exercised": {
          "items": {
            "$ref": "#/$defs/AuthorityClass"
          },
          "title": "Unauthorized Exercised",
          "type": "array"
        }
      },
      "title": "AuthorityAssessment",
      "type": "object"
    },
    "AuthorityClass": {
      "enum": [
        "READ",
        "RECOMMEND",
        "WRITE",
        "EXECUTE",
        "EXTERNALIZE",
        "AUTHORIZE"
      ],
      "title": "AuthorityClass",
      "type": "string",
      "description": "READ, RECOMMEND, WRITE, EXECUTE, EXTERNALIZE, or AUTHORIZE authority class from Maple Quanta Agentic AI Containment Assurance."
    },
    "BlastRadius": {
      "enum": [
        "BR0",
        "BR1",
        "BR2",
        "BR3",
        "BR4",
        "BR5"
      ],
      "title": "BlastRadius",
      "type": "string",
      "description": "BR0 Single action/session through BR5 Potentially systemic."
    },
    "BoundaryType": {
      "enum": [
        "none",
        "instruction_policy",
        "data",
        "tool",
        "credential",
        "privilege",
        "network",
        "tenant",
        "evaluation_real_world",
        "third_party"
      ],
      "title": "BoundaryType",
      "type": "string",
      "description": "Machine identifiers for B0 None through B9 Third Party / External. See the MQ-AICIR taxonomy for code labels."
    },
    "ClassificationIndicator": {
      "description": "Analyst-attested facts used by transparent severity rules.",
      "enum": [
        "destructive_action",
        "cross_tenant_compromise",
        "autonomous_offensive_cyber",
        "credential_propagation",
        "broad_privileged_access",
        "persistent_unauthorized_access",
        "sensitive_data_exposure",
        "production_impact",
        "approval_bypass",
        "external_action",
        "critical_action",
        "preventive_control_absent",
        "third_party_impact"
      ],
      "title": "ClassificationIndicator",
      "type": "string"
    },
    "ContainmentMetrics": {
      "additionalProperties": false,
      "properties": {
        "detection_time_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Time Seconds"
        },
        "decision_time_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Time Seconds"
        },
        "enforcement_time_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enforcement Time Seconds"
        },
        "intervention_time_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intervention Time Seconds"
        },
        "damage_time_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Damage Time Seconds"
        },
        "containment_margin": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Containment Margin"
        },
        "metric_misleading": {
          "default": false,
          "title": "Metric Misleading",
          "type": "boolean"
        },
        "instantaneous_action": {
          "default": false,
          "title": "Instantaneous Action",
          "type": "boolean"
        },
        "not_applicable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Applicable Reason"
        },
        "documentation": {
          "default": "",
          "title": "Documentation",
          "type": "string"
        },
        "preventive_control": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preventive Control"
        }
      },
      "title": "ContainmentMetrics",
      "type": "object"
    },
    "ControlPerformance": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "minLength": 1,
          "title": "Control Id",
          "type": "string"
        },
        "control_name": {
          "minLength": 1,
          "title": "Control Name",
          "type": "string"
        },
        "expected_behavior": {
          "minLength": 1,
          "title": "Expected Behavior",
          "type": "string"
        },
        "observed_behavior": {
          "minLength": 1,
          "title": "Observed Behavior",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ControlStatus"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "control_id",
        "control_name",
        "expected_behavior",
        "observed_behavior",
        "status"
      ],
      "title": "ControlPerformance",
      "type": "object"
    },
    "ControlStatus": {
      "enum": [
        "effective",
        "partially_effective",
        "failed",
        "not_tested",
        "not_applicable",
        "unknown"
      ],
      "title": "ControlStatus",
      "type": "string"
    },
    "CorrectiveAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^CA-[A-Z0-9-]+$",
          "title": "Action Id",
          "type": "string"
        },
        "finding": {
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "recommended_action": {
          "minLength": 1,
          "title": "Recommended Action",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/CorrectiveActionPriority"
        },
        "owner": {
          "default": "",
          "title": "Owner",
          "type": "string"
        },
        "due_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Date"
        },
        "status": {
          "$ref": "#/$defs/CorrectiveActionStatus",
          "default": "open"
        },
        "verification_required": {
          "default": true,
          "title": "Verification Required",
          "type": "boolean"
        },
        "verification_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Verification Evidence",
          "type": "array"
        }
      },
      "required": [
        "action_id",
        "finding",
        "recommended_action",
        "priority"
      ],
      "title": "CorrectiveAction",
      "type": "object"
    },
    "CorrectiveActionPriority": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "title": "CorrectiveActionPriority",
      "type": "string"
    },
    "CorrectiveActionStatus": {
      "enum": [
        "open",
        "in_progress",
        "complete",
        "accepted_risk"
      ],
      "title": "CorrectiveActionStatus",
      "type": "string"
    },
    "CrosswalkReference": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "relationship": {
          "title": "Relationship",
          "type": "string"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified At"
        }
      },
      "required": [
        "title",
        "relationship",
        "source_version"
      ],
      "title": "CrosswalkReference",
      "type": "object"
    },
    "Crosswalks": {
      "additionalProperties": false,
      "properties": {
        "safe": {
          "items": {
            "$ref": "#/$defs/CrosswalkReference"
          },
          "title": "Safe",
          "type": "array"
        },
        "mitre_atlas": {
          "items": {
            "$ref": "#/$defs/CrosswalkReference"
          },
          "title": "Mitre Atlas",
          "type": "array"
        },
        "nist": {
          "items": {
            "$ref": "#/$defs/CrosswalkReference"
          },
          "title": "Nist",
          "type": "array"
        },
        "oecd": {
          "items": {
            "$ref": "#/$defs/CrosswalkReference"
          },
          "title": "Oecd",
          "type": "array"
        }
      },
      "title": "Crosswalks",
      "type": "object"
    },
    "CustodyEvent": {
      "additionalProperties": false,
      "properties": {
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "timestamp",
        "actor",
        "action"
      ],
      "title": "CustodyEvent",
      "type": "object"
    },
    "EventState": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ],
      "title": "EventState",
      "type": "string",
      "description": "E0 Hazard; E1 Near Miss; E2 Boundary Violation; E3 Incident; E4 Serious/Systemic Incident. E4 is not a jurisdiction-specific legal conclusion."
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A reference to preserved evidence; never embed credentials or secrets.",
      "properties": {
        "id": {
          "pattern": "^EV-[A-Z0-9-]+$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "location": {
          "description": "Reference or controlled location, not the evidence secret itself.",
          "title": "Location",
          "type": "string"
        },
        "hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional digest including algorithm, e.g. sha256:...",
          "title": "Hash"
        },
        "collected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected At"
        },
        "collected_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected By"
        },
        "chain_of_custody": {
          "items": {
            "$ref": "#/$defs/CustodyEvent"
          },
          "title": "Chain Of Custody",
          "type": "array"
        },
        "redacted": {
          "default": false,
          "title": "Redacted",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "description",
        "location"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "agent_trace",
        "prompt",
        "system_prompt",
        "tool_call",
        "tool_response",
        "network_log",
        "iam_log",
        "cloud_log",
        "application_log",
        "model_version",
        "system_configuration",
        "policy_version",
        "credentials_available_to_agent",
        "affected_file",
        "screenshot",
        "forensic_image",
        "human_communication",
        "incident_ticket",
        "other"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "FrameworkInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "Maple Quanta AI Incident Classification & Reporting Framework",
          "default": "Maple Quanta AI Incident Classification & Reporting Framework",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "FrameworkInfo",
      "type": "object"
    },
    "Handling": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "$ref": "#/$defs/HandlingClassification",
          "default": "CONFIDENTIAL"
        },
        "distribution": {
          "items": {
            "type": "string"
          },
          "title": "Distribution",
          "type": "array"
        },
        "retention_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Policy"
        }
      },
      "title": "Handling",
      "type": "object"
    },
    "HandlingClassification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "HandlingClassification",
      "type": "string",
      "description": "Incident-level information handling marking."
    },
    "HarmAssessment": {
      "additionalProperties": false,
      "properties": {
        "realized_level": {
          "$ref": "#/$defs/HarmLevel"
        },
        "potential_level": {
          "$ref": "#/$defs/HarmLevel"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/HarmCategory"
          },
          "title": "Categories",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "realized_level",
        "potential_level"
      ],
      "title": "HarmAssessment",
      "type": "object"
    },
    "HarmCategory": {
      "enum": [
        "confidentiality",
        "integrity",
        "availability",
        "financial",
        "privacy",
        "legal",
        "reputational",
        "human_safety",
        "fundamental_rights",
        "environmental",
        "critical_infrastructure",
        "third_party"
      ],
      "title": "HarmCategory",
      "type": "string"
    },
    "HarmLevel": {
      "enum": [
        "H0",
        "H1",
        "H2",
        "H3",
        "H4"
      ],
      "title": "HarmLevel",
      "type": "string",
      "description": "H0 No Realized Harm; H1 Negligible; H2 Material; H3 Major; H4 Severe/Systemic."
    },
    "LifecycleOverride": {
      "additionalProperties": false,
      "properties": {
        "responsible_person": {
          "minLength": 1,
          "title": "Responsible Person",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "responsible_person",
        "timestamp",
        "rationale"
      ],
      "title": "LifecycleOverride",
      "type": "object"
    },
    "LifecycleState": {
      "enum": [
        "DRAFT",
        "TRIAGE",
        "ACTIVE",
        "CONTAINED",
        "INVESTIGATION",
        "REMEDIATION",
        "REVALIDATION",
        "CLOSED"
      ],
      "title": "LifecycleState",
      "type": "string",
      "description": "DRAFT, TRIAGE, ACTIVE, CONTAINED, INVESTIGATION, REMEDIATION, REVALIDATION, or CLOSED."
    },
    "MCAIAssessment": {
      "additionalProperties": false,
      "properties": {
        "pre_incident_assessed": {
          "anyOf": [
            {
              "$ref": "#/$defs/MCAILevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "post_incident_reassessed": {
          "anyOf": [
            {
              "$ref": "#/$defs/MCAILevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "MCAIAssessment",
      "type": "object"
    },
    "MCAILevel": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4"
      ],
      "title": "MCAILevel",
      "type": "string",
      "description": "Maple Quanta Maximum Credible Agent Impact: A0 Informational through A4 Critical."
    },
    "NotificationDecision": {
      "enum": [
        "yes",
        "no",
        "pending"
      ],
      "title": "NotificationDecision",
      "type": "string"
    },
    "Notifications": {
      "additionalProperties": false,
      "properties": {
        "affected_internal_teams": {
          "items": {
            "type": "string"
          },
          "title": "Affected Internal Teams",
          "type": "array"
        },
        "affected_third_parties": {
          "items": {
            "type": "string"
          },
          "title": "Affected Third Parties",
          "type": "array"
        },
        "regulators": {
          "items": {
            "type": "string"
          },
          "title": "Regulators",
          "type": "array"
        },
        "law_enforcement": {
          "items": {
            "type": "string"
          },
          "title": "Law Enforcement",
          "type": "array"
        },
        "contractual_notification_required": {
          "$ref": "#/$defs/NotificationDecision",
          "default": "pending"
        },
        "regulatory_notification_required": {
          "$ref": "#/$defs/NotificationDecision",
          "default": "pending"
        },
        "legal_review_required": {
          "default": true,
          "title": "Legal Review Required",
          "type": "boolean"
        }
      },
      "title": "Notifications",
      "type": "object"
    },
    "ObservabilityAssessment": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/ObservabilityLevel",
          "description": "O0 is best and O4 is worst; unlike most dimensions, a larger number means poorer observability."
        },
        "evidence_sources": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Sources",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "tamper_risk": {
          "default": false,
          "title": "Tamper Risk",
          "type": "boolean"
        }
      },
      "required": [
        "level"
      ],
      "title": "ObservabilityAssessment",
      "type": "object"
    },
    "ObservabilityLevel": {
      "enum": [
        "O0",
        "O1",
        "O2",
        "O3",
        "O4"
      ],
      "title": "ObservabilityLevel",
